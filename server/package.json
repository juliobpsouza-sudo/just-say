{
  "name": "just-say-server",
  "version": "0.1.4",
  "description": "Backend local do Just Say: STT + refino com provedores gratuitos em cascata.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
